# Configuración web pública de Firebase (Project settings → General → Your apps → Web app).
# Estos valores viajan en el bundle del navegador: es normal y esperado en Firebase.
# La seguridad real la dan las reglas de firestore.rules, no el secreto de estas claves.
# Si dejas el archivo vacío, CotizaPro arranca en modo demo local (usuarios en localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Asesor de proyectos con IA (Google Gemini, capa gratuita): https://aistudio.google.com/app/apikey
# Opcional: con Firebase activo la clave se configura desde Ajustes → Asesor con IA y se guarda
# en el documento config/ia de Firestore. Esta variable es el respaldo para el modo demo.
VITE_GEMINI_API_KEY=
