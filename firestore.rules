rules_version = '2';

// Reglas de seguridad de CotizaPro.
// Publícalas con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().rol == 'Administrador'
        && perfil().activo == true;
    }

    function activo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }

    function tienePermiso(permiso) {
      return esAdmin() || (activo() && perfil().permisos.hasAny([permiso]));
    }

    match /usuarios/{uid} {
      // Cada usuario lee su propio perfil; el administrador lee todos.
      allow get: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      // Solo el administrador crea perfiles (rol, permisos y estado incluidos).
      allow create: if esAdmin();

      // El propio usuario únicamente puede apagar su bandera de primer ingreso
      // y registrar su último acceso: nunca su rol, permisos ni estado activo.
      allow update: if esAdmin()
        || (
          request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.permisos == resource.data.permisos
          && request.resource.data.activo == resource.data.activo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['debeCambiarPassword', 'ultimoIngreso'])
        );

      allow delete: if esAdmin();
    }

    // Inventario compartido: todo el equipo lo consulta y solo el administrador lo modifica,
    // salvo el stock: al aceptar una cotización el vendedor descuenta las cantidades
    // vendidas (y las devuelve si se revierte el estado), sin tocar ningún otro campo.
    match /materiales/{materialId} {
      allow read: if activo();
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (activo()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['stock', 'actualizado'])
            && request.resource.data.stock is number);
    }

    // Clientes: compartidos por todo el equipo, para no registrar el mismo cliente por cada
    // vendedor. Quien tenga el permiso los crea y actualiza (sin cambiar quién lo creó); solo el
    // administrador los elimina.
    match /clientes/{clienteId} {
      allow read: if activo();
      allow create: if esAdmin()
        || (tienePermiso('clientes.crear')
            && request.resource.data.creadoPor == request.auth.uid);
      allow update: if esAdmin()
        || (tienePermiso('clientes.crear')
            && request.resource.data.get('creadoPor', null) == resource.data.get('creadoPor', null));
      allow delete: if esAdmin();
    }

    // Cotizaciones: el vendedor ve las propias (borradores incluidos) y las ya emitidas de todo el
    // equipo, para conocer el historial de cada cliente; solo modifica las propias. La app consulta
    // por separado where('vendedorUid', '==', uid) y where('estado', '!=', 'Borrador').
    match /cotizaciones/{cotizacionId} {
      allow read: if esAdmin()
        || (activo()
            && (resource.data.vendedorUid == request.auth.uid
                || resource.data.estado != 'Borrador'));
      allow create: if esAdmin()
        || (tienePermiso('cotizaciones.crear')
            && request.resource.data.vendedorUid == request.auth.uid);
      allow update: if esAdmin()
        || (activo()
            && resource.data.vendedorUid == request.auth.uid
            && request.resource.data.vendedorUid == resource.data.vendedorUid);
      allow delete: if esAdmin()
        || (activo() && resource.data.vendedorUid == request.auth.uid);
    }

    // asesorias: historial del Asesor de proyectos. Cada vendedor guarda y lee sus propias
    // conversaciones; el administrador las ve todas. La app borra las vencidas (campo vence).
    match /asesorias/{asesoriaId} {
      allow read: if esAdmin()
        || (activo() && resource.data.vendedorUid == request.auth.uid);
      allow create: if esAdmin()
        || (tienePermiso('asesor.ia')
            && request.resource.data.vendedorUid == request.auth.uid);
      allow update: if esAdmin()
        || (activo()
            && resource.data.vendedorUid == request.auth.uid
            && request.resource.data.vendedorUid == resource.data.vendedorUid);
      allow delete: if esAdmin()
        || (activo() && resource.data.vendedorUid == request.auth.uid);
    }

    // enlaces/{cotizacionId}: copia de solo lectura que ve el cliente en /c/{cotizacionId}, sin
    // sesión. Solo se lee conociendo el id (no se puede listar). La publica quien puede leer la
    // cotización al abrir Compartir: su dueño, el administrador o el equipo si ya no es borrador.
    match /enlaces/{cotizacionId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.cotizacion.id == cotizacionId
        && (esAdmin()
            || (activo()
                && exists(/databases/$(database)/documents/cotizaciones/$(cotizacionId))
                && (get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.vendedorUid == request.auth.uid
                    || get(/databases/$(database)/documents/cotizaciones/$(cotizacionId)).data.estado != 'Borrador')));
      allow delete: if esAdmin();
    }

    // consecutivos/cotizaciones: contador compartido del número de cotización. Cualquier
    // vendedor activo lo incrementa dentro de una transacción, pero nunca lo retrocede.
    match /consecutivos/{documento} {
      allow read: if activo();
      allow create: if activo();
      allow update: if activo() && request.resource.data.ultimo > resource.data.ultimo;
      allow delete: if esAdmin();
    }

    // config/empresa: datos de la empresa (logo, NIT, IVA); solo el administrador los edita.
    match /config/{documento} {
      allow read: if activo();
      allow create, update, delete: if esAdmin();
    }
  }
}
